---
import "@fontsource-variable/baloo-2/wght.css";
import "../styles/global.css";
import Logo from "../components/Logo.astro";

interface Props {
  title?: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | eiilo games` : "eiilo games";
const canonical = new URL(Astro.url.pathname, Astro.site);
const main = "https://eiilo.com";
const path = Astro.url.pathname;

// The same bar as eiilo.com. Everything but Games is on that site.
const nav = [
  { name: "Home", path: `${main}/` },
  { name: "Games", path: "/" },
  { name: "Blog", path: "https://blog.eiilo.com/" },
  { name: "Updates", path: `${main}/updates/` },
  { name: "About us", path: `${main}/about/` },
  { name: "Contact", path: `${main}/contact/` },
];
const footer = [
  { name: "eiilo.com", path: `${main}/` },
  { name: "Privacy policy", path: `${main}/privacy/` },
  { name: "Terms and conditions", path: `${main}/terms/` },
  { name: "Sitemap", path: "/sitemap/" },
  { name: "RSS", path: "/rss.xml" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="alternate" type="application/rss+xml" title="eiilo games" href="/rss.xml" />
    <meta name="theme-color" content="#171b2a" />
    <script is:inline>
      // No motion when the system asks for reduced motion. Runs before
      // anything is drawn; motion.js follows the setting if it changes.
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("still");
    </script>
    <meta property="og:site_name" content="eiilo games" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title ?? "eiilo games"} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="glow" aria-hidden="true"></div>
    <header class="nav">
      <div class="wrap">
        <a class="nav-logo" href={`${main}/`} aria-label="eiilo, home">
          <Logo />
        </a>
        <nav aria-label="Main">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.path} aria-current={item.path === path ? "page" : undefined}>
                    {item.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>
    <script is:inline>
      // The first screen is exactly the bar plus the hero: tell the CSS how
      // tall the bar is (it wraps onto two lines on a narrow screen).
      (() => {
        const bar = document.querySelector(".nav");
        const set = () => document.documentElement.style.setProperty("--nav-h", bar.offsetHeight + "px");
        set();
        new ResizeObserver(set).observe(bar);
      })();
    </script>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap">
        <p>
          &copy; Copyright {new Date().getFullYear()} <a class="brand" href="https://eiilo.com">eiilo</a>
        </p>
        <ul>
          {footer.map((item) => <li><a href={item.path}>{item.name}</a></li>)}
        </ul>
        <p class="marks">
          Apple and the Apple logo are trademarks of Apple Inc., registered in the U.S. and other countries and
          regions. App Store is a service mark of Apple Inc. Google Play and the Google Play logo are trademarks of
          Google LLC.
        </p>
      </div>
    </footer>
    <script>
      import "../scripts/motion.js";
    </script>
  </body>
</html>

<style>
  /* The stores' credit lines, on a row of their own under the footer links.
     Here and not in global.css, which is a copy of eiilo.com's. */
  .marks {
    flex-basis: 100%;
    margin: 0;
    font-size: 0.85rem;
  }
</style>
