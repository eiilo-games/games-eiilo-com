---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Logo3D from "../components/Logo3D.astro";
import Cubes from "../components/Cubes.astro";
import { games, gameGroups, stores } from "../data/games";

// What drifts behind the logo. The games named here are large and sharp;
// the others are small and blurred, further back. Mood Dude is not a block:
// the dude himself stands there, hopping and changing mood.
const mainGames = ["Mood Dude", "Tiny Landlord", "Bounce Court"];
const cubeIcons = games.map((game) => ({
  icon: game.icon,
  main: mainGames.includes(game.name),
  kind: game.name === "Mood Dude" ? ("dude" as const) : ("cube" as const),
}));

// The stores' marks on the store buttons, drawn in a 24 by 24 box (from
// Simple Icons, CC0): the Apple logo, and the Google Play triangle as its
// four parts, each in its own colour. In one colour the triangle reads as a
// button that plays something.
const marks = {
  appStore:
    "M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701",
  googlePlay: [
    { fill: "#fbbc04", d: "M22.018 13.298l-3.919 2.218-3.515-3.493 3.543-3.521 3.891 2.202a1.49 1.49 0 0 1 0 2.594z" },
    { fill: "#4285f4", d: "M1.337.924a1.486 1.486 0 0 0-.112.568v21.017c0 .217.045.419.124.6l11.155-11.087L1.337.924z" },
    { fill: "#34a853", d: "M13.544 10.989l3.258-3.238L3.45.195a1.466 1.466 0 0 0-.946-.179l11.04 10.973z" },
    { fill: "#ea4335", d: "M13.544 13.056l-11 10.933c.298.036.612-.016.906-.183l13.324-7.54-3.23-3.21z" },
  ],
};
---

<Base description={`The ${games.length} mobile games made by eiilo games, ${stores}.`}>
  <section class="hero is-compact">
    <Cubes icons={cubeIcons} />
    <div class="wrap hero-inner">
      <div class="hero-stage">
        <Cubes layout="cluster" icons={cubeIcons} />
        <Logo3D label="eiilo games" viewBox="226 428 750 312" layers={16} />
      </div>
      <h1>{games.length} games, {stores}.</h1>
    </div>
    <a class="hero-next" href="#games" aria-label="Go to the games">
      <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
        <path d="M5 9l7 7 7-7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>
  </section>

  <div class="wrap" id="games">
    {
      gameGroups.map((group) => (
        <section class="section group">
          <div class="section-head">
            <h2>{group.title}</h2>
          </div>
          {group.intro && <p class="section-intro">{group.intro}</p>}
          <ul class="cards">
            {group.games.map((game, i) => (
              <li data-reveal style={`--order:${i % 3}`}>
                <article class="card game" data-tilt>
                  <Image class="pop" src={game.icon} alt="" width={80} height={80} densities={[1, 2]} />
                  <div>
                    <h3>{game.name}</h3>
                    <p>{game.summary}</p>
                  </div>
                  <p class="buttons">
                    {game.appStore && (
                      <a
                        class="btn is-small is-quiet is-icon"
                        href={game.appStore}
                        aria-label={`${game.name} on the App Store`}
                        title="App Store"
                      >
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path d={marks.appStore} />
                        </svg>
                      </a>
                    )}
                    <a
                      class="btn is-small is-quiet is-icon"
                      href={game.googlePlay}
                      aria-label={`${game.name} on Google Play`}
                      title="Google Play"
                    >
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        {marks.googlePlay.map((part) => (
                          <path fill={part.fill} d={part.d} />
                        ))}
                      </svg>
                    </a>
                    <a class="btn is-small" href={game.website} aria-label={`${game.name} website`}>
                      Website
                    </a>
                  </p>
                </article>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>

<style>
  /* The buttons on a game's card. Here and not in global.css, which is a
     copy of eiilo.com's.

     A store's button is a dark key that shows the store's mark instead of
     its name, as tall as the Website button beside it, which is the mint
     one. */
  .btn.is-small.is-icon {
    display: grid;
    place-items: center;
    padding: 0.4rem 0.7rem;
    transition:
      transform 0.12s ease-out,
      box-shadow 0.12s ease-out,
      background-color 0.15s,
      border-color 0.15s;
  }

  .is-icon svg {
    width: 1.3rem;
    height: 1.3rem;
    fill: currentColor;
  }

  /* Under the pointer, or the keyboard's focus, a button rises as every
     button does, and lights up: a store's key gets a mint rim and a paler
     face, the Website button a paler face and a glow. */
  .btn.is-small.is-icon:hover,
  .btn.is-small.is-icon:focus-visible {
    color: var(--text);
    background: #343b5c;
    border-color: var(--eiilo-primary);
  }

  .buttons .btn:not(.is-icon):hover,
  .buttons .btn:not(.is-icon):focus-visible {
    background: linear-gradient(120deg, #b4f5ba, #a3f1cf);
  }

  /* Not while it is pressed: the press flattens the button's edge. */
  .buttons .btn:not(.is-icon):hover:not(:active) {
    box-shadow:
      0 6px 0 var(--edge),
      0 0.6rem 1.5rem -0.2rem rgb(122 224 180 / 0.65);
  }
</style>
