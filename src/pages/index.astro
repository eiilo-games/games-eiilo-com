---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Logo3D from "../components/Logo3D.astro";
import Cubes from "../components/Cubes.astro";
import { games, gameGroups } from "../data/games";

// What drifts behind the logo. The games named here are large and sharp;
// the others are small and blurred, further back. Mood Dude is not a block:
// the dude himself stands there, hopping and changing mood.
const mainGames = ["Mood Dude", "Tiny Landlord", "Bounce Court"];
const cubeIcons = games.map((game) => ({
  icon: game.icon,
  main: mainGames.includes(game.name),
  kind: game.name === "Mood Dude" ? ("dude" as const) : ("cube" as const),
}));
---

<Base description={`The ${games.length} mobile games made by eiilo games, all free on Google Play.`}>
  <section class="hero is-compact">
    <Cubes icons={cubeIcons} />
    <div class="wrap hero-inner">
      <div class="hero-stage">
        <Cubes layout="cluster" icons={cubeIcons} />
        <Logo3D label="eiilo games" viewBox="226 428 750 312" layers={16} />
      </div>
      <h1>{games.length} games, all free on Google Play.</h1>
    </div>
    <a class="hero-next" href="#games" aria-label="Go to the games">
      <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
        <path d="M5 9l7 7 7-7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>
  </section>

  <div class="wrap" id="games">
    {
      gameGroups.map((group) => (
        <section class="section group">
          <div class="section-head">
            <h2>{group.title}</h2>
          </div>
          {group.intro && <p class="section-intro">{group.intro}</p>}
          <ul class="cards">
            {group.games.map((game, i) => (
              <li data-reveal style={`--order:${i % 3}`}>
                <article class="card game" data-tilt>
                  <Image class="pop" src={game.icon} alt="" width={80} height={80} densities={[1, 2]} />
                  <div>
                    <h3>{game.name}</h3>
                    <p>{game.summary}</p>
                  </div>
                  <p class="buttons">
                    <a class="btn is-small" href={game.googlePlay} aria-label={`${game.name} on Google Play`}>
                      Google Play
                    </a>
                    <a class="btn is-small is-quiet" href={game.website} aria-label={`${game.name} website`}>
                      Website
                    </a>
                  </p>
                </article>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>
